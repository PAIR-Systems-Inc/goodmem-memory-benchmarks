# Downloaded datasets stay local; keep only their setup guide in Git.
data/*
!data/.gitkeep
!data/README.md
# Keep run exports in Git and leave full working files local.
results/*
!results/.gitkeep
!results/*/
results/*/*
!results/*/export/
!results/*/export/*
results/_archive/
.env
__pycache__/
*.py[cod]
.venv/
.reranker-venv/
.ruff_cache/
.pytest_cache/
docs/*.pdf
