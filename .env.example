# GoodMem connection. The local example uses a self-signed certificate.
# Set GMBENCH_TLS_VERIFY=true when the server has a trusted certificate.
GOODMEM_BASE_URL=https://localhost:8080
GOODMEM_API_KEY=
GMBENCH_TLS_VERIFY=false

# Model registration UUIDs on this instance. Find them with
# `goodmem embedder list`, `goodmem reranker list` and `goodmem llm list`.
GMBENCH_EMBEDDER_ID=
GMBENCH_RERANKER_ID=

# Reader and judge calls use GoodMem's provider proxy and stored credentials.
# Map each reader name to its registration; use gpt-4o-mini-2024-07-18 as judge.
GMBENCH_READER_LLM_IDS=gpt-4o-mini=,gpt-4.1-mini=
GMBENCH_JUDGE_LLM_ID=
