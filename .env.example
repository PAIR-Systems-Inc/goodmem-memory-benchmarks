# GoodMem instance (REST API). The local dev server serves REST on 8080 over
# self-signed TLS; set GMBENCH_TLS_VERIFY=false for that case.
GOODMEM_BASE_URL=https://localhost:8080
GOODMEM_API_KEY=
GMBENCH_TLS_VERIFY=false

# No provider key is needed here. The reader and judge run through GoodMem's
# provider proxy against registered LLMs, so the key stays in the instance.
