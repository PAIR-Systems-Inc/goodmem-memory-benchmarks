# GoodMem instance under test. The local development server exposes REST on
# 8080 behind a self-signed certificate, which is what GMBENCH_TLS_VERIFY=false
# is for; set it to true against anything real.
GOODMEM_BASE_URL=https://localhost:8080
GOODMEM_API_KEY=
GMBENCH_TLS_VERIFY=false

# Registrations on your instance. `goodmem embedder list`, `goodmem reranker
# list` and `goodmem llm list` print the UUIDs.
GMBENCH_EMBEDDER_ID=
GMBENCH_RERANKER_ID=

# Reader and judge run through GoodMem's provider proxy, so no provider key is
# needed here: the credential stays in the instance. Register the paper's models
# and point these at them.
GMBENCH_READER_LLM_IDS=gpt-4o-mini=,gpt-4.1-mini=
GMBENCH_JUDGE_LLM_ID=
